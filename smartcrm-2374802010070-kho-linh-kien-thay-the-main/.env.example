# Backend and standalone frontend ports
APP_PORT=3000
FRONTEND_PORT=5173
API_PORT=3000

# API path used by the backend-served UI
API_BASE_URL=/api/v1

# Optional. Leave blank to use src/backend/data/smartcrm.db
SMARTCRM_DB_PATH=

# Optional for local demo. Set a random 64-character hex value for stable sessions.
AUTH_TOKEN_SECRET=
